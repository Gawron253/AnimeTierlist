<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AnimeTierlist.Desktop</RootNamespace>
    <AssemblyName>AnimeTierlist</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Description>Portable Windows desktop app for ranking anime seasons from LiveChart.</Description>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Portable Windows x64 distribution with its own runtime. Libraries stay RID-neutral. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AnimeTierlist.Application\AnimeTierlist.Application.csproj" />
    <ProjectReference Include="..\AnimeTierlist.Infrastructure\AnimeTierlist.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Packaged page for the in-app YouTube player, served from a WebView2 virtual host. -->
    <Content Include="Assets\Player\player.html;Assets\Player\player.js;Assets\Player\player.css" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AnimeTierlist.Desktop.Tests" />
  </ItemGroup>
  <!-- Native package debug symbols (libSkiaSharp.pdb is ~100 MB) are not shipped in the portable release. -->
  <Target Name="ExcludeNativePackageSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And $([System.String]::Copy('%(Filename)').StartsWith('AnimeTierlist')) != 'true'" />
    </ItemGroup>
  </Target>
</Project>
