<Window x:Class="AnimeTierlist.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
        xmlns:views="clr-namespace:AnimeTierlist.Desktop.Views"
        xmlns:controls="clr-namespace:AnimeTierlist.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Title}" Width="1240" Height="820" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}"
        Closing="OnClosing" SizeChanged="OnWindowSizeChanged" PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding Project.UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding Project.RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding Project.RedoCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding Project.ToggleSidebarCommand}" />
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <views:BindingProxy x:Key="ShellProxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:InverseBooleanToVisibilityConverter x:Key="Hidden" />
        <views:NotEmptyToVisibilityConverter x:Key="IfAny" />

        <DataTemplate DataType="{x:Type vm:AcquisitionViewModel}">
            <views:AcquisitionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CollectionViewModel}">
            <views:CollectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoardViewModel}">
            <views:BoardView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Bottom status bar with live-region announcement -->
        <Border DockPanel.Dock="Bottom" Height="26" Background="{DynamicResource Brush.BgSurface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding FooterStatus}" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FooterStatus}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="F1 Shortcuts · Ctrl+B Sidebar" FontSize="11" />
            </Grid>
        </Border>

        <!-- Project picker when no project is open -->
        <views:ProjectPickerView Visibility="{Binding HasProject, Converter={StaticResource Hidden}}" />

        <!-- Open project workspace -->
        <DockPanel Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <!-- Fixed single-row 46-DIP top app bar -->
            <Border DockPanel.Dock="Top" Height="46" Background="{DynamicResource Brush.BgSurface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sidebar toggle, project name, breadcrumb (truncates first), save status pill (never clips) -->
                    <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource IconButton}" Command="{Binding Project.ToggleSidebarCommand}" Margin="0,0,8,0"
                                Click="OnSidebarToggleClick"
                                ToolTip="Toggle sidebar navigation (Ctrl+B)" AutomationProperties.Name="Toggle navigation sidebar">
                            <Path Data="{StaticResource Icon.Sidebar}" Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" />
                        </Button>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Subtitle}" Text="{Binding Project.Name}" VerticalAlignment="Center"
                                   MaxWidth="160" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Name}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Muted}" Text="  ›  " VerticalAlignment="Center"
                                   Visibility="{Binding Project.Breadcrumb, Converter={StaticResource IfAny}}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="{Binding Project.Breadcrumb}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.Breadcrumb}"
                                   Visibility="{Binding Project.Breadcrumb, Converter={StaticResource IfAny}}" />

                        <!-- Honest save state pill -->
                        <Border Grid.Column="4" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Project.IsSaving}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentFill}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Project.SaveFailed}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Project.SaveText}" FontSize="11" FontWeight="SemiBold"
                                       MaxWidth="136" TextTrimming="CharacterEllipsis" ToolTip="{Binding Project.SaveText}"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Project.IsSaving}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Project.SaveFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Right: Undo/Redo (concise labels, full action in Tooltip and UIA Name), Export, Close, Menu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding Project.UndoCommand}" Margin="0,0,4,0"
                                AutomationProperties.Name="{Binding Project.UndoAccessibleName}"
                                ToolTip="{Binding Project.UndoLabel, StringFormat=Undo {0} (Ctrl+Z), TargetNullValue=Nothing to undo (Ctrl+Z)}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Undo}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" VerticalAlignment="Center" />
                                <TextBlock Text="Undo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding Project.RedoCommand}" Margin="0,0,6,0"
                                AutomationProperties.Name="{Binding Project.RedoAccessibleName}"
                                ToolTip="{Binding Project.RedoLabel, StringFormat=Redo {0} (Ctrl+Y), TargetNullValue=Nothing to redo (Ctrl+Y)}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Redo}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,5,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" VerticalAlignment="Center" />
                                <TextBlock Text="Redo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Content="Export project..." Command="{Binding Project.ExportProjectCommand}" Margin="0,0,6,0" />
                        <Button Content="Close project" Command="{Binding CloseCommand}" Margin="0,0,4,0" />
                        <Button x:Name="ShellMoreButton" Style="{StaticResource IconButton}" Click="OnShellMoreClick"
                                ToolTip="App menu (Theme, Shortcuts, Data folder)" AutomationProperties.Name="Application menu">
                            <Path Data="{StaticResource Icon.More}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" />
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{Binding ThemeLabel}" Command="{Binding CycleThemeCommand}" />
                                    <MenuItem Header="Keyboard shortcuts..." Command="{Binding ShowShortcutsCommand}" InputGestureText="F1" />
                                    <Separator />
                                    <MenuItem Header="Open projects folder" Command="{Binding OpenProjectsFolderCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Persistent Save-Failure suspension banner -->
            <controls:InfoBar DockPanel.Dock="Top" Severity="Danger" Margin="10,6,10,0"
                              Title="Save failed — editing is paused until resolved"
                              Message="{Binding Project.SaveFailureDetail}"
                              Visibility="{Binding Project.SaveFailed, Converter={StaticResource Visible}}">
                <controls:InfoBar.ActionContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Retry save" Command="{Binding Project.RetrySaveCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource DangerButton}" Content="Discard unsaved changes" Command="{Binding Project.ConfirmDiscardChangesCommand}" />
                    </StackPanel>
                </controls:InfoBar.ActionContent>
            </controls:InfoBar>

            <!-- Main split: Collapsible Sidebar + Content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="232" />
                    <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border x:Name="SidebarHost" Grid.Column="0" Background="{DynamicResource Brush.BgSurface}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,1,0" Padding="10,12"
                        Visibility="{Binding Project.SidebarCollapsed, Converter={StaticResource Hidden}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"
                                AutomationProperties.Name="New collection..."
                                Command="{Binding Project.NewCollectionCommand}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" VerticalAlignment="Center" />
                                <AccessText Text="_New collection..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <DockPanel Grid.Row="1" Margin="2,0,2,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding Project.Collections.Count}" />
                            <TextBlock Style="{StaticResource Text.Section}" Text="COLLECTIONS" />
                        </DockPanel>

                        <ListBox x:Name="CollectionsList" Grid.Row="2" ItemsSource="{Binding Project.Collections}" SelectedItem="{Binding Project.SelectedCollection}"
                                 AutomationProperties.Name="Collections" BorderThickness="0" Background="Transparent" Padding="0"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnSidebarMouseDown" PreviewMouseMove="OnSidebarMouseMove"
                                 DragOver="OnSidebarDragOver" DragLeave="OnSidebarDragLeave" Drop="OnSidebarDrop">
                            <ListBox.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding Project.RenameCollectionCommand}" CommandParameter="{Binding Project.SelectedCollection}" />
                                <KeyBinding Key="Delete" Command="{Binding Project.DeleteCollectionCommand}" CommandParameter="{Binding Project.SelectedCollection}" />
                                <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Project.MoveCollectionUpCommand}" CommandParameter="{Binding Project.SelectedCollection}" />
                                <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Project.MoveCollectionDownCommand}" CommandParameter="{Binding Project.SelectedCollection}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Context}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="ToolTip" Value="Drag to reorder. Right-click for rename or delete." />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Rename..." Command="{Binding Data.Project.RenameCollectionCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move up" Command="{Binding Data.Project.MoveCollectionUpCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move down" Command="{Binding Data.Project.MoveCollectionDownCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Delete..." Command="{Binding Data.Project.DeleteCollectionCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}"
                                                          Foreground="{DynamicResource Brush.DangerText}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CollectionItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3" CornerRadius="1.5" Margin="0,1,6,1" Background="{DynamicResource Brush.AccentFill}"
                                                Visibility="{Binding IsActiveBoardSource, Converter={StaticResource Visible}}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Opacity="0.85"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Text="{Binding Context}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource Brush.BgRaised}" CornerRadius="8"
                                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Text="{Binding CountBadge}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <DockPanel Grid.Row="3" Margin="2,12,2,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Muted}" Text="{Binding Project.Boards.Count}" />
                            <TextBlock Style="{StaticResource Text.Section}" Text="BOARDS" />
                        </DockPanel>

                        <ListBox x:Name="BoardsList" Grid.Row="4" ItemsSource="{Binding Project.Boards}" SelectedItem="{Binding Project.SelectedBoard}"
                                 AutomationProperties.Name="Boards" BorderThickness="0" Background="Transparent" Padding="0"
                                 AllowDrop="True"
                                 PreviewMouseLeftButtonDown="OnSidebarMouseDown" PreviewMouseMove="OnSidebarMouseMove"
                                 DragOver="OnSidebarDragOver" DragLeave="OnSidebarDragLeave" Drop="OnSidebarDrop">
                            <ListBox.InputBindings>
                                <KeyBinding Key="F2" Command="{Binding Project.RenameBoardCommand}" CommandParameter="{Binding Project.SelectedBoard}" />
                                <KeyBinding Key="Delete" Command="{Binding Project.DeleteBoardCommand}" CommandParameter="{Binding Project.SelectedBoard}" />
                                <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Project.MoveBoardUpCommand}" CommandParameter="{Binding Project.SelectedBoard}" />
                                <KeyBinding Key="Down" Modifiers="Alt" Command="{Binding Project.MoveBoardDownCommand}" CommandParameter="{Binding Project.SelectedBoard}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="AutomationProperties.HelpText" Value="{Binding Context}" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="ToolTip" Value="Drag to reorder. Right-click for rename or delete." />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Rename..." Command="{Binding Data.Project.RenameBoardCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move up" Command="{Binding Data.Project.MoveBoardUpCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <MenuItem Header="Move down" Command="{Binding Data.Project.MoveBoardDownCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Delete..." Command="{Binding Data.Project.DeleteBoardCommand, Source={StaticResource ShellProxy}}" CommandParameter="{Binding}"
                                                          Foreground="{DynamicResource Brush.DangerText}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BoardItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="11" Opacity="0.85"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       Text="{Binding Context, StringFormat=from {0}}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource Brush.BgRaised}" CornerRadius="8"
                                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Text="{Binding ProgressBadge}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeDirection="Columns"
                              DragCompleted="OnSidebarSplitterDragCompleted"
                              Visibility="{Binding Project.SidebarCollapsed, Converter={StaticResource Hidden}}" />

                <ContentControl Grid.Column="2" Content="{Binding Project.Content}" Focusable="False" />
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
