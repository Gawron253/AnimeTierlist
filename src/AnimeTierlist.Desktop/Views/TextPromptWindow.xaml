<Window x:Class="AnimeTierlist.Desktop.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}">
    <DockPanel Margin="18,16">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
        <TextBlock x:Name="DescriptionText" DockPanel.Dock="Top" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="88" />
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="110" Click="OnConfirm" />
        </StackPanel>

        <StackPanel>
            <Label x:Name="FieldLabel" Target="{Binding ElementName=InputBox}" Margin="0,0,0,4" />
            <TextBox x:Name="InputBox" AutomationProperties.LabeledBy="{Binding ElementName=FieldLabel}" TextChanged="OnInputChanged" />
            <TextBlock x:Name="NoteText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
