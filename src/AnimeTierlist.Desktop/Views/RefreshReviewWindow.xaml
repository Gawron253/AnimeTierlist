<Window x:Class="AnimeTierlist.Desktop.Views.RefreshReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
        xmlns:views="clr-namespace:AnimeTierlist.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RefreshReviewViewModel}"
        Title="{Binding Heading}" Width="740" Height="620" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:NotEmptyToVisibilityConverter x:Key="IfAny" />
    </Window.Resources>
    <DockPanel Margin="18,14">
        <!-- Header + summary count pills -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Your inclusion choices, custom titles, chosen covers, and existing boards stay untouched. Nothing changes until you apply this update, and applying it is one undoable step." />
            <WrapPanel>
                <Border Background="{DynamicResource Brush.AccentSurface}" BorderBrush="{DynamicResource Brush.AccentFill}"
                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                        Visibility="{Binding Added.Count, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold"
                               Text="{Binding Added.Count, StringFormat=+{0} new}" />
                </Border>
                <Border Background="{DynamicResource Brush.WarningSurface}" BorderBrush="{DynamicResource Brush.WarningBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                        Visibility="{Binding NoLongerListed.Count, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.WarningText}" FontWeight="SemiBold"
                               Text="{Binding NoLongerListed.Count, StringFormat={}{0} unlisted}" />
                </Border>
                <Border Background="{DynamicResource Brush.SuccessSurface}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                        Visibility="{Binding Reappeared.Count, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.SuccessText}" FontWeight="SemiBold"
                               Text="{Binding Reappeared.Count, StringFormat={}{0} reappeared}" />
                </Border>
                <Border Background="{DynamicResource Brush.BgRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                        Visibility="{Binding TitleChangeRows.Count, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                               Text="{Binding TitleChangeRows.Count, StringFormat={}{0} title changes}" />
                </Border>
                <Border Background="{DynamicResource Brush.BgRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="0,0,6,4"
                        Visibility="{Binding CoverCandidateChanges, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="{Binding CoverCandidateChanges, StringFormat={}{0} cover links updated}" />
                </Border>
            </WrapPanel>
        </StackPanel>

        <!-- Pinned Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="92" />
                    <Button Style="{StaticResource PrimaryButton}" Content="_Apply update" IsDefault="True" Click="OnApply" MinWidth="120" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Text="Applying this update is one undoable step (Ctrl+Z)." />
            </DockPanel>
        </Border>

        <!-- Explicit order choice callout -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}" Text="COLLECTION ORDER" Margin="0,0,0,6" />
                <RadioButton GroupName="RefreshOrder" IsChecked="{Binding KeepManualOrder}" Margin="0,0,0,6"
                             Content="Keep my current order (new shows append at the end, excluded)" />
                <RadioButton GroupName="RefreshOrder" IsChecked="{Binding AdoptSourceOrder}"
                             Content="Adopt LiveChart's latest popularity order (replaces manual order; shows no longer listed move to the end)" />
            </StackPanel>
        </Border>

        <!-- Scrollable diff sections -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Expander IsExpanded="True" Margin="0,0,0,8" Visibility="{Binding Added.Count, Converter={StaticResource IfAny}}">
                    <Expander.Header>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Added.Count, StringFormat=New shows: {0} (added excluded)}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Added}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,8" Visibility="{Binding NoLongerListed.Count, Converter={StaticResource IfAny}}">
                    <Expander.Header>
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Text="{Binding NoLongerListed.Count, StringFormat=No longer listed by LiveChart: {0} (kept and flagged)}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding NoLongerListed}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,8" Visibility="{Binding Reappeared.Count, Converter={StaticResource IfAny}}">
                    <Expander.Header>
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Text="{Binding Reappeared.Count, StringFormat=Listed again: {0}}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding Reappeared}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Expander IsExpanded="True" Margin="0,0,0,8" Visibility="{Binding TitleChangeRows.Count, Converter={StaticResource IfAny}}">
                    <Expander.Header>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding TitleChangeRows.Count, StringFormat=LiveChart title changes: {0}}" />
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding TitleChangeRows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TitleChangeRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Before}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Muted}" Text="  →  " VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.BodyStrong}" Text="{Binding After}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="10,8"
                        Visibility="{Binding CoverCandidateChanges, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="{Binding CoverCandidateChanges, StringFormat=LiveChart updated image links for {0} show(s). Existing valid covers are preserved; fetch covers after applying to download images for shows without a cover.}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
