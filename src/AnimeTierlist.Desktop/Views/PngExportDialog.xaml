<Window x:Class="AnimeTierlist.Desktop.Views.PngExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
        xmlns:controls="clr-namespace:AnimeTierlist.Desktop.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PngExportPreviewViewModel}"
        Title="{Binding BoardName, StringFormat='Export {0} as PNG'}" Width="560" SizeToContent="Height" MaxHeight="600" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </Window.Resources>
    <DockPanel Margin="18,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding BoardName, StringFormat='Export {0} as PNG'}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Exports the saved board revision using a deterministic layout that never depends on window size, scrolling, search highlight, or UI theme." />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="_Update board..." Click="OnOpenUpdateBoard"
                        Visibility="{Binding CanOpenUpdateBoard, Converter={StaticResource Visible}}"
                        ToolTip="Close this preview and open the reviewed Board Update dialog to refresh covers or membership" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Choose _file..." IsDefault="True"
                            IsEnabled="{Binding CanContinue}" Click="OnContinue" MinWidth="120" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel>
            <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="EXPORT SCOPE" Margin="0,0,0,8" />
                    <RadioButton GroupName="PngScope" IsChecked="{Binding IncludeUnranked}" Margin="0,0,0,6"
                                 Content="{Binding IncludeUnrankedOptionLabel}" />
                    <RadioButton GroupName="PngScope" IsChecked="{Binding ExcludeUnranked}" Margin="0,0,0,10"
                                 Content="Tiers only (omit Unranked section)" />
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding ScopeSummary}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding DimensionsText}" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <controls:InfoBar Severity="Warning" Title="In-scope export issue detected" Message="{Binding BlockerSummary}"
                              Visibility="{Binding HasBlockers, Converter={StaticResource Visible}}" Margin="0,0,0,8" />

            <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="8" MaxHeight="160"
                    Visibility="{Binding HasBlockers, Converter={StaticResource Visible}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MissingOrBrokenInScope}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
