<UserControl x:Class="AnimeTierlist.Desktop.Views.AcquisitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
             xmlns:views="clr-namespace:AnimeTierlist.Desktop.Views"
             xmlns:controls="clr-namespace:AnimeTierlist.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AcquisitionViewModel}"
             Background="{DynamicResource Brush.BgCanvas}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:NotEmptyToVisibilityConverter x:Key="IfAny" />
    </UserControl.Resources>

    <DockPanel Margin="16,12">
        <!-- Top configuration card -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource Text.Title}" Text="New collection from LiveChart" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextWrapping="Wrap"
                       Text="A whole year combines Winter, Spring, Summer, and Fall in calendar order, each preserving LiveChart's exact popularity sequence." />

            <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Label Content="_Year" Target="{Binding ElementName=YearBox}" Margin="0,0,4,6" />
                        <Button Content="−" Command="{Binding DecrementYearCommand}" Padding="0"
                                AutomationProperties.Name="Previous year" Margin="0,0,3,6" Width="28" Height="30" />
                        <TextBox x:Name="YearBox" Width="68" Text="{Binding YearText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Year" HorizontalContentAlignment="Center" Margin="0,0,3,6" KeyDown="OnYearKeyDown" />
                        <Button Content="+" Command="{Binding IncrementYearCommand}" Padding="0"
                                AutomationProperties.Name="Next year" Margin="0,0,12,6" Width="28" Height="30" />

                        <Label Content="_Season" Target="{Binding ElementName=SeasonBox}" Margin="0,0,4,6" />
                        <ComboBox x:Name="SeasonBox" Width="122" ItemsSource="{Binding SeasonOptions}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Season" SelectedItem="{Binding Season}" Margin="0,0,12,6" />

                        <Label Content="Cate_gory" Target="{Binding ElementName=CategoryBox}" Margin="0,0,4,6" />
                        <ComboBox x:Name="CategoryBox" Width="104" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label"
                                  AutomationProperties.Name="Category" SelectedItem="{Binding Category}" Margin="0,0,12,6" />

                        <Button Style="{StaticResource PrimaryButton}" Content="_Fetch from LiveChart" Command="{Binding FetchCommand}"
                                IsDefault="True" Margin="0,0,6,6" />
                        <Button Content="Cancel" Command="{Binding FetchCancelCommand}" Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Season pacing & validation stepper (visible during whole-year or active fetches) -->
                    <ItemsControl ItemsSource="{Binding SeasonSteps}" Margin="0,4,0,0" Focusable="False"
                                  Visibility="{Binding IsWholeYear, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SeasonStepItem}">
                                <Border CornerRadius="5" BorderThickness="1" Padding="8,5" Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.BgRaised}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Requesting">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentFill}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Validated">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SuccessSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Empty">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.WarningSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding Label}" FontSize="12" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" FontSize="11" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="{Binding RequiredSeasonCount}" Value="{Binding ValidatedSeasonCount}"
                                 IsIndeterminate="{Binding IsIndeterminateProgress}" Visibility="{Binding IsFetching, Converter={StaticResource Visible}}" />

                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ProgressText}" />
                </StackPanel>
            </Border>

            <!-- Error InfoBar -->
            <controls:InfoBar Severity="Danger" Title="Could not complete LiveChart fetch" Message="{Binding Failure}"
                              Margin="0,0,0,10" Visibility="{Binding Failure, Converter={StaticResource IfAny}}" />

            <!-- Commit preview header -->
            <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.AccentFill}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                    Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding PreviewSummary}" />
                    <WrapPanel VerticalAlignment="Center">
                        <Label Content="Collection na_me" Target="{Binding ElementName=NameBox}" Margin="0,0,6,0" />
                        <TextBox x:Name="NameBox" Width="280" Text="{Binding CollectionName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Collection name" KeyDown="OnNameKeyDown" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButton}" Content="C_reate collection" Command="{Binding CreateCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Virtualized ordered preview -->
        <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1" CornerRadius="8" Padding="4"
                Visibility="{Binding HasPreview, Converter={StaticResource Visible}}">
            <ListBox ItemsSource="{Binding PreviewEntries}" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Preview in LiveChart popularity order"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PreviewEntryItem}">
                        <Grid Margin="2,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="12" Opacity="0.82"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       Text="{Binding Ordinal, StringFormat=#{0}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            <Border Grid.Column="2" Background="{DynamicResource Brush.BgRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding SeasonTag, Converter={StaticResource IfAny}}">
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Text="{Binding SeasonTag}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
