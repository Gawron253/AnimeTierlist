<Window x:Class="AnimeTierlist.Desktop.Views.BoardUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
        xmlns:views="clr-namespace:AnimeTierlist.Desktop.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BoardUpdateViewModel}"
        Title="{Binding Heading}" Width="740" SizeToContent="Height" MaxHeight="660" MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}">
    <Window.Resources>
        <views:NotEmptyToVisibilityConverter x:Key="IfAny" />
        <DataTemplate x:Key="Show" DataType="{x:Type vm:SelectableShow}">
            <CheckBox Margin="0,3" IsChecked="{Binding IsSelected}" Content="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="18,14">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Heading}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Choose membership and pinned presentation changes separately. Existing tier placements stay intact. Applying is one undoable command." />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="92" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding ApplyButtonLabel}" IsDefault="True"
                            IsEnabled="{Binding HasSelectedChanges}" Click="OnApply" MinWidth="130" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="If removals are selected, declining the confirmation cancels the entire update." />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Additions card -->
                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                        Visibility="{Binding Additions.Count, Converter={StaticResource IfAny}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Content="Select all" Command="{Binding SelectAllAdditionsCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource LinkButton}" Content="None" Command="{Binding SelectNoAdditionsCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Text="{Binding AdditionsSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Additions}" ItemTemplate="{StaticResource Show}" Focusable="False" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Removals card -->
                <Border Background="{DynamicResource Brush.WarningSurface}" BorderBrush="{DynamicResource Brush.WarningBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10"
                        Visibility="{Binding Removals.Count, Converter={StaticResource IfAny}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource LinkButton}" Content="Select all" Command="{Binding SelectAllRemovalsCommand}" Margin="0,0,6,0" />
                                <Button Style="{StaticResource LinkButton}" Content="None" Command="{Binding SelectNoRemovalsCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.BodyStrong}" Foreground="{DynamicResource Brush.WarningText}"
                                       Text="{Binding RemovalsSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Removals}" ItemTemplate="{StaticResource Show}" Focusable="False" Margin="4,0,0,0" />
                    </StackPanel>
                </Border>

                <!-- Presentation update card -->
                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.BodyStrong}" Text="Pinned titles and covers on this board" Margin="0,0,0,8" />
                        <RadioButton GroupName="BoardPresentation" IsChecked="{Binding IsKeepPinned}" Margin="0,0,0,6"
                                     Content="Keep pinned titles and covers unchanged" />
                        <RadioButton GroupName="BoardPresentation" IsChecked="{Binding IsFillMissing}" Margin="0,0,0,6"
                                     Content="Fill missing or damaged covers only (keeps titles and valid covers)" />
                        <RadioButton GroupName="BoardPresentation" IsChecked="{Binding IsFullRefresh}" Margin="0,0,0,8"
                                     Content="Refresh all titles and covers from the collection" />

                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding PresentationPreview}" />
                        <ItemsControl Margin="8,6,0,0" ItemsSource="{Binding PresentationChanges}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
