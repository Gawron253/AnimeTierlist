<Window x:Class="AnimeTierlist.Desktop.Views.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcuts" Width="620" SizeToContent="Height" MaxHeight="680" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{DynamicResource Brush.BgCanvas}" Foreground="{DynamicResource Brush.TextPrimary}"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BgRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderControl}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="18,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource Text.Title}" Text="Keyboard shortcuts" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                       Text="Every curation, ranking, tier edit, and export workflow is accessible without a mouse." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="Close" IsDefault="True" IsCancel="True" MinWidth="92" />
        </StackPanel>

        <ScrollViewer x:Name="ShortcutsScroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Global -->
                <Border x:Name="GlobalCard" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="GLOBAL" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+Z" /></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Undo last project command" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="1" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+Y / Ctrl+Shift+Z" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Redo command" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="2" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+B" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Toggle navigation sidebar" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="3" Style="{StaticResource KeyBadge}" Margin="0,0,8,0"><TextBlock Style="{StaticResource Text.Keycap}" Text="F1" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Open or close keyboard shortcuts" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Collection -->
                <Border x:Name="CollectionCard" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="COLLECTION CURATION" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Space" /></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Include or exclude selected show(s)" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="1" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Alt+I / Alt+X" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Include all shows / exclude all shows" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="2" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Alt+Up / Alt+Down" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Move selected show earlier or later" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="3" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Alt+Home / Alt+End" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Move selected show to top or bottom" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="4" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+F / Esc" /></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Focus search / clear search" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="5" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="F2 / Ctrl+Shift+R" /></Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Edit custom title / rename collection" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="6" Style="{StaticResource KeyBadge}" Margin="0,0,8,0"><TextBlock Style="{StaticResource Text.Keycap}" Text="F4 / Alt+B" /></Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Toggle inspector / create board from included shows" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Board -->
                <Border x:Name="BoardCard" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="RANKING BOARD" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="1–9 (or NumPad 1–9)" /></Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Move focused show to tier 1–9" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="1" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="0 (or NumPad 0)" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Return focused show to Unranked" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="2" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+Left / Ctrl+Right" /></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Reorder show within its tier" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="3" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Alt+Up / Alt+Down" /></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Move show to row above or below" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="4" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Double-click / Enter" /></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Open LiveChart details and duplicate entry" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="5" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+F / F3 / Shift+F3" /></Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Find show / jump next or previous match" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="6" Style="{StaticResource KeyBadge}" Margin="0,0,8,4"><TextBlock Style="{StaticResource Text.Keycap}" Text="Ctrl+U / Alt+E / F4" /></Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Toggle Unranked tray / open Tier editor / toggle inspector" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <Border Grid.Row="7" Style="{StaticResource KeyBadge}" Margin="0,0,8,0"><TextBlock Style="{StaticResource Text.Keycap}" Text="F2 / Alt+P" /></Border>
                            <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="Rename board / export board as PNG" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
