<UserControl x:Class="AnimeTierlist.Desktop.Views.BoardEntryDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
             xmlns:views="clr-namespace:AnimeTierlist.Desktop.Views"
             xmlns:controls="clr-namespace:AnimeTierlist.Desktop.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BoardEntryDetailsViewModel}"
             d:DesignWidth="680" d:DesignHeight="700"
             AutomationProperties.Name="{Binding WindowTitle}" UseLayoutRounding="True"
             Foreground="{DynamicResource Brush.TextPrimary}"
             x:Name="DialogRoot">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <views:InverseBooleanToVisibilityConverter x:Key="Hidden" />
        <views:NotEmptyToVisibilityConverter x:Key="IfAny" />
        <views:EqualsToBooleanConverter x:Key="EqBool" />

        <DataTemplate x:Key="VideoRowTemplate" DataType="{x:Type vm:VideoLinkViewModel}">
            <!-- Main action plays YouTube links in the app; the side button always opens the external browser. -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding DataContext.PlayVideoCommand, ElementName=DialogRoot}" CommandParameter="{Binding}"
                        HorizontalContentAlignment="Stretch" Padding="10,7"
                        ToolTip="{Binding Url}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Category badge: OP / ED / Video -->
                        <Border Grid.Column="0" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.BgSurface}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsThemeSong}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSurface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentFill}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Video}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsThemeSong}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Music}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding BadgeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsThemeSong}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Title + audio/subtitle metadata + optional spoiler tag -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Brush.WarningSurface}" BorderBrush="{DynamicResource Brush.WarningBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasSpoilers, Converter={StaticResource Visible}}">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.WarningText}" Text="SPOILERS" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding LanguageSummary}" Margin="0,2,0,0"
                                       Visibility="{Binding LanguageSummary, Converter={StaticResource IfAny}}" />
                        </StackPanel>

                        <!-- Duration pill -->
                        <Border Grid.Column="2" Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                Visibility="{Binding Duration, Converter={StaticResource IfAny}}">
                            <TextBlock Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Text="{Binding Duration}" />
                        </Border>

                        <!-- Play icon for in-app playback, external link icon otherwise -->
                        <Path Grid.Column="3" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource Icon.ExternalLink}" />
                                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanPlayInApp}" Value="True">
                                            <Setter Property="Data" Value="M4,2.5 L13,8 L4,13.5 Z" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.AccentText}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="8,7" Margin="6,0,0,0"
                        Command="{Binding DataContext.OpenVideoCommand, ElementName=DialogRoot}" CommandParameter="{Binding}"
                        Visibility="{Binding CanPlayInApp, Converter={StaticResource Visible}}"
                        ToolTip="Open in your browser" AutomationProperties.Name="{Binding OpenExternallyAccessibleName}">
                    <Path Data="{StaticResource Icon.ExternalLink}" Width="13" Height="13" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="18,16">
        <!-- Bottom action bar -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="_Duplicate entry" Command="{Binding DuplicateEntryCommand}"
                            ToolTip="Add a numbered copy right next to the original in Unranked (for ranking multiple openings or endings)"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource DangerButton}" Content="{Binding RemoveCopyButtonLabel}" Command="{Binding RemoveThisCopyCommand}"
                            Visibility="{Binding IsDuplicate, Converter={StaticResource Visible}}" Margin="0,0,8,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close" Click="OnCloseClick" MinWidth="84" ToolTip="Close (Esc)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Header: Poster with red copy number overlay + Title + External site icons/links -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="126" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="116" Height="166" CornerRadius="6" Background="{DynamicResource Brush.BgPosterMat}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6"
                                        Visibility="{Binding HasCover, Converter={StaticResource Hidden}}">
                                <Path Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.ImageOff}" />
                                            <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
                                            <Setter Property="StrokeThickness" Value="1.5" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBrokenCover}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Warning}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource Brush.DangerText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Text="{Binding CoverPlaceholder}"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <controls:CopyNumberOverlay CopyNumber="{Binding CopyNumber}"
                                                        Visibility="{Binding IsDuplicate, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Border Background="{DynamicResource Brush.AccentSurface}" BorderBrush="{DynamicResource Brush.AccentFill}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}"
                                           FontWeight="SemiBold" Text="{Binding CopySummary}" />
                            </Border>
                            <Border Background="{DynamicResource Brush.BgRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                <TextBlock Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Text="{Binding LiveChartIdText}" />
                            </Border>
                        </WrapPanel>

                        <!-- External site links with crisp icons: LiveChart, AniList, MyAnimeList -->
                        <WrapPanel Margin="0,6,0,0">
                            <Button Command="{Binding OpenOnLiveChartCommand}" Padding="9,4" MinHeight="28" Margin="0,0,6,4"
                                    ToolTip="{Binding LiveChartUrl}" AutomationProperties.Name="Open on LiveChart">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.LiveChart}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="LiveChart" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenOnAniListCommand}" Padding="9,4" MinHeight="28" Margin="0,0,6,4"
                                    ToolTip="{Binding AniListUrl}" AutomationProperties.Name="Open on AniList"
                                    Visibility="{Binding HasAniListUrl, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.AniList}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="AniList" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenOnMyAnimeListCommand}" Padding="9,4" MinHeight="28" Margin="0,0,6,4"
                                    ToolTip="{Binding MyAnimeListUrl}" AutomationProperties.Name="Open on MyAnimeList"
                                    Visibility="{Binding HasMyAnimeListUrl, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.MyAnimeList}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="MyAnimeList" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshLiveDataCommand}" Padding="8,4" MinHeight="28" Margin="0,0,0,4"
                                    ToolTip="Fetch fresh OP/ED videos, details, and external links from LiveChart"
                                    AutomationProperties.Name="Refresh details and videos from LiveChart">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Refresh}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SourceAppearanceText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <!-- Alternate titles from LiveChart -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                       Visibility="{Binding HasEnglishTitle, Converter={StaticResource Visible}}">
                                <Run Text="English: " Foreground="{DynamicResource Brush.TextMuted}" />
                                <Run Text="{Binding EnglishTitle, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding HasRomanizedTitle, Converter={StaticResource Visible}}">
                                <Run Text="Romanized: " Foreground="{DynamicResource Brush.TextMuted}" />
                                <Run Text="{Binding RomanizedTitle, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding HasNativeTitle, Converter={StaticResource Visible}}">
                                <Run Text="Native: " Foreground="{DynamicResource Brush.TextMuted}" />
                                <Run Text="{Binding NativeTitle, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Duplicate confirmation banner -->
                <Border Background="{DynamicResource Brush.SuccessSurface}" BorderBrush="{DynamicResource Brush.SuccessBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                        Visibility="{Binding DuplicateFeedback, Converter={StaticResource IfAny}}">
                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.SuccessText}"
                               FontWeight="SemiBold" Text="{Binding DuplicateFeedback}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                </Border>

                <!-- Videos card: OP / ED prioritized first, Other videos on a separate tab -->
                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Section}" Text="VIDEOS" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton Style="{StaticResource SegmentedRadioStyle}" GroupName="DetailsVideoTab"
                                             Content="{Binding ThemeVideosTabLabel}"
                                             IsChecked="{Binding SelectedVideoTab, Converter={StaticResource EqBool}, ConverterParameter=Themes}"
                                             Margin="0,0,6,0" />
                                <RadioButton Style="{StaticResource SegmentedRadioStyle}" GroupName="DetailsVideoTab"
                                             Content="{Binding OtherVideosTabLabel}"
                                             IsChecked="{Binding SelectedVideoTab, Converter={StaticResource EqBool}, ConverterParameter=Other}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Loading indicator -->
                        <StackPanel Visibility="{Binding IsLoadingLiveData, Converter={StaticResource Visible}}" Margin="0,2,0,6">
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding LiveDataStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <ProgressBar IsIndeterminate="True" Height="4" />
                        </StackPanel>

                        <!-- Save error banner with save-only retry (accessible directly inside modal dialog) -->
                        <Border Background="{DynamicResource Brush.WarningSurface}" BorderBrush="{DynamicResource Brush.WarningBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding SaveError, Converter={StaticResource IfAny}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Retry save" Command="{Binding RetrySaveCommand}"
                                        Visibility="{Binding ShowRetrySaveButton, Converter={StaticResource Visible}}"
                                        Padding="10,3" MinHeight="26" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.WarningText}"
                                           Text="{Binding SaveError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Fetch error banner with HTTP retry -->
                        <Border Background="{DynamicResource Brush.DangerSurface}" BorderBrush="{DynamicResource Brush.DangerBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                Visibility="{Binding LiveDataError, Converter={StaticResource IfAny}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding RetryLiveDataCommand}"
                                        Padding="10,3" MinHeight="26" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.DangerText}"
                                           Text="{Binding LiveDataError}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Tab 1: OPs and EDs (priority first) -->
                        <StackPanel Visibility="{Binding ShowThemeVideos, Converter={StaticResource Visible}}">
                            <ItemsControl ItemsSource="{Binding ThemeVideos}" ItemTemplate="{StaticResource VideoRowTemplate}" Focusable="False" />
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNoThemeVideos, Converter={StaticResource Visible}}"
                                       Text="No opening or ending videos are listed on LiveChart for this anime yet." />
                        </StackPanel>

                        <!-- Tab 2: Other videos (PVs, trailers, spots, insert songs) -->
                        <StackPanel Visibility="{Binding ShowOtherVideos, Converter={StaticResource Visible}}">
                            <ItemsControl ItemsSource="{Binding OtherVideos}" ItemTemplate="{StaticResource VideoRowTemplate}" Focusable="False" />
                            <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                       Visibility="{Binding HasNoOtherVideos, Converter={StaticResource Visible}}"
                                       Text="No other promotional videos are listed on LiveChart for this anime." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LiveChart Details card -->
                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="LIVECHART DETAILS" Margin="0,0,0,8" />

                        <StackPanel Visibility="{Binding HasExtendedDetails, Converter={StaticResource Visible}}">
                            <Grid Margin="0,0,0,4" Visibility="{Binding Rating, Converter={StaticResource IfAny}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Muted}" Text="Rating" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.BodyStrong}" Text="{Binding Rating}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,4" Visibility="{Binding Premiere, Converter={StaticResource IfAny}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Muted}" Text="Premiere" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Premiere}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,4" Visibility="{Binding Metadata, Converter={StaticResource IfAny}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Muted}" Text="Format" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding Metadata}" TextWrapping="Wrap" />
                            </Grid>

                            <Grid Margin="0,0,0,6" Visibility="{Binding StudiosText, Converter={StaticResource IfAny}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Text.Muted}" Text="Studios" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" Text="{Binding StudiosText}" TextWrapping="Wrap" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Tags}" Focusable="False" Margin="0,2,0,8"
                                          Visibility="{Binding Tags.Count, Converter={StaticResource IfAny}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Brush.BgRaised}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,6,6">
                                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Synopsis}" TextWrapping="Wrap"
                                       Visibility="{Binding Synopsis, Converter={StaticResource IfAny}}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowOlderSnapshotHint, Converter={StaticResource Visible}}"
                                   Text="Additional LiveChart details were not stored in this older snapshot. Click Refresh above to fetch them from LiveChart." />
                    </StackPanel>
                </Border>

                <!-- Copies on this board card -->
                <Border Background="{DynamicResource Brush.BgSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Section}" Text="COPIES ON THIS BOARD" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Copies}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Duplicating adds a numbered copy (2, 3, 4...) in Unranked right next to the original so you can rank multiple openings or endings separately." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
