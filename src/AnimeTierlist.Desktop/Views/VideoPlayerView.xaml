<UserControl x:Class="AnimeTierlist.Desktop.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AnimeTierlist.Desktop.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VideoPlayerViewModel}"
             d:DesignWidth="960" d:DesignHeight="640"
             AutomationProperties.Name="{Binding WindowTitle}" UseLayoutRounding="True"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <DockPanel x:Name="RootPanel" Margin="14,12">
        <!-- Header: what is playing and the player state -->
        <DockPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding StatusText}"
                       VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
        </DockPanel>

        <!-- Footer: YouTube attribution, external fallback, close -->
        <Border x:Name="FooterPanel" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Watch on _YouTube" Command="{Binding WatchOnYouTubeCommand}" Margin="0,0,8,0"
                            ToolTip="{Binding VideoUrl}" AutomationProperties.Name="Watch on YouTube in your browser" />
                    <Button Content="Close" Click="OnCloseClick" MinWidth="84" ToolTip="Close (Esc)" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Video provided by YouTube." VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Style="{StaticResource LinkButton}" Content="YouTube Terms of Service" Command="{Binding OpenTermsCommand}"
                            Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Open the YouTube Terms of Service" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Player area. The browser is a native child window, so nothing WPF is drawn over it; the fallback replaces it. -->
        <Grid MinWidth="320" MinHeight="180" Background="Black">
            <wv2:WebView2 x:Name="PlayerView" DefaultBackgroundColor="Black" AllowExternalDrop="False"
                          Visibility="{Binding IsPlayerVisible, Converter={StaticResource Visible}}"
                          AutomationProperties.Name="YouTube video player" />

            <Border Background="{DynamicResource Brush.BgSurface}" Padding="24"
                    Visibility="{Binding IsUnavailable, Converter={StaticResource Visible}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Style="{StaticResource Text.BodyStrong}" Text="This video can't play in the app" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding UnavailableMessage}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.LiveSetting="Assertive" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Watch on YouTube" HorizontalAlignment="Center"
                            Command="{Binding WatchOnYouTubeCommand}" AutomationProperties.Name="Watch on YouTube in your browser" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
