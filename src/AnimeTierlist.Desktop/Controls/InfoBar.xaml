<UserControl x:Class="AnimeTierlist.Desktop.Controls.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border x:Name="BarBorder" CornerRadius="6" BorderThickness="1" Padding="10,6" SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path x:Name="SeverityIcon" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding Title, ElementName=Root}" />
                <TextBlock x:Name="MessageText" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,0"
                           Text="{Binding Message, ElementName=Root}" />
            </StackPanel>
            <ContentPresenter Grid.Column="2" Content="{Binding ActionContent, ElementName=Root}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="DismissButton" Grid.Column="3" Style="{StaticResource IconButton}" Margin="6,0,0,0" VerticalAlignment="Center"
                    AutomationProperties.Name="Dismiss message" ToolTip="Dismiss" Click="OnDismissClick">
                <Path Data="{StaticResource Icon.Close}" Width="11" Height="11" Stretch="Uniform"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
            </Button>
        </Grid>
    </Border>
</UserControl>
