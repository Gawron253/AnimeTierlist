<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Windows High Contrast override: maps every semantic brush to live SystemColors. Reloaded on theme change. -->
    <SolidColorBrush x:Key="Brush.BgCanvas" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.BgSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.BgRaised" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Brush.BgInput" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.BgHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.BgSelected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.BgOverlay" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.BgPosterMat" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.PoolHeader" Color="{x:Static SystemColors.ControlColor}" />

    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.BorderControl" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.TextOnHover" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.TextOnSelected" Color="{x:Static SystemColors.HighlightTextColor}" />

    <SolidColorBrush x:Key="Brush.AccentFill" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Brush.AccentSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{x:Static SystemColors.HotTrackColor}" />

    <SolidColorBrush x:Key="Brush.SuccessText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.SuccessSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.WarningText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.WarningSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.DangerFill" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Brush.OnDanger" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Brush.DangerText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.DangerSurface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.BadgeOverlay" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.BadgeOverlayText" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="Brush.DisabledBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.DisabledBorder" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="{x:Static SystemColors.GrayTextColor}" />
</ResourceDictionary>
