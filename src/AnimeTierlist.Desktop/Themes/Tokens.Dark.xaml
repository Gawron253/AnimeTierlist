<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- Dark theme semantic palette: verified WCAG 2.1 AA (>= 4.5:1 text, >= 3.0:1 borders/focus). -->
    <SolidColorBrush x:Key="Brush.BgCanvas" Color="#111318" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BgSurface" Color="#181B22" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BgRaised" Color="#21252F" po:Freeze="True" />
