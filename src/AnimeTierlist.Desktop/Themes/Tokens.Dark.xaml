    <SolidColorBrush x:Key="Brush.BgPosterMat" Color="#0D0F14" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.PoolHeader" Color="#282E3A" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#2C3240" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.BorderControl" Color="#7C869B" po:Freeze="True" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F0F3F8" po:Freeze="True" />
